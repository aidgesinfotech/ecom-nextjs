# ─── MySQL (Hostinger) ───
# Hostinger hPanel → Databases → Remote MySQL: allow access (or use % for Vercel IPs)
DB_HOST=srv905.hstgr.io
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Optional: set to true if Hostinger requires SSL for remote connections
DB_SSL=false

# ─── Admin auth ───
JWT_KEY=change-this-to-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-after-first-login

# One-time DB bootstrap (POST /api/setup with header x-setup-secret)
SETUP_SECRET=change-this-setup-secret

# ─── Hostinger FTP (admin image uploads) ───
FTP_HOST=
FTP_USER=
FTP_PASSWORD=
# Public domain for uploaded files (no https://)
FTP_BASE_URL=asset.svarnibeauty.com
FTP_UPLOAD_DIR=/public_html/
FTP_SECURE=false
FTP_PRODUCT_DIR=aikvis-products
